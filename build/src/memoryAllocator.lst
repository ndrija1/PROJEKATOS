  82:src/memoryAllocator.cpp **** 
  83:src/memoryAllocator.cpp **** int MemoryAllocator::mem_free(void *ptr) {
  84:src/memoryAllocator.cpp ****     if (!ptr) return -1;
  85:src/memoryAllocator.cpp **** 
  86:src/memoryAllocator.cpp ****     FreeMemBlk* curr = freeMemHead;
  87:src/memoryAllocator.cpp ****     FreeMemBlk* prev = nullptr;
  88:src/memoryAllocator.cpp ****     FreeMemBlk* free_blk = (FreeMemBlk*)ptr - 1;
  89:src/memoryAllocator.cpp **** 
  90:src/memoryAllocator.cpp **** 
  91:src/memoryAllocator.cpp ****     if (ptr < HEAP_START_ADDR || ptr >= HEAP_END_ADDR) return -1;
  92:src/memoryAllocator.cpp **** 
  93:src/memoryAllocator.cpp ****     //The whole address space was allocated
  94:src/memoryAllocator.cpp ****     if (!curr) {
  95:src/memoryAllocator.cpp ****         freeMemHead = free_blk;
  96:src/memoryAllocator.cpp ****         free_blk->next = nullptr;
  97:src/memoryAllocator.cpp ****         return 0;
  98:src/memoryAllocator.cpp ****     }
  99:src/memoryAllocator.cpp ****     if (free_blk < curr) {
 100:src/memoryAllocator.cpp ****         free_blk->next = freeMemHead;
 101:src/memoryAllocator.cpp ****         freeMemHead = free_blk;
 102:src/memoryAllocator.cpp ****         merge(freeMemHead);
 103:src/memoryAllocator.cpp ****         return 0;
 104:src/memoryAllocator.cpp ****     }
