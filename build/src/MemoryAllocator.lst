  88:src/MemoryAllocator.cpp **** int MemoryAllocator::mem_free(void *ptr) {
  89:src/MemoryAllocator.cpp ****     if (!ptr) return -1;
  90:src/MemoryAllocator.cpp ****     if (ptr < HEAP_START_ADDR || ptr >= HEAP_END_ADDR) return -1;
  91:src/MemoryAllocator.cpp **** 
  92:src/MemoryAllocator.cpp **** 
  93:src/MemoryAllocator.cpp ****     FreeBlock* curr = freeListHead;
  94:src/MemoryAllocator.cpp ****     FreeBlock* prev = nullptr;
  95:src/MemoryAllocator.cpp ****     FreeBlock* free_blk = reinterpret_cast<FreeBlock*>(ptr) - 1;
  96:src/MemoryAllocator.cpp **** 
  97:src/MemoryAllocator.cpp **** 
  98:src/MemoryAllocator.cpp ****     //The whole address space was allocated
  99:src/MemoryAllocator.cpp ****     if (!curr) {
 100:src/MemoryAllocator.cpp ****         freeListHead = free_blk;
 101:src/MemoryAllocator.cpp ****         free_blk->next = nullptr;
 102:src/MemoryAllocator.cpp ****         return 0;
 103:src/MemoryAllocator.cpp ****     }
 104:src/MemoryAllocator.cpp ****     if (free_blk < curr) {
 105:src/MemoryAllocator.cpp ****         free_blk->next = freeListHead;
 106:src/MemoryAllocator.cpp ****         freeListHead = free_blk;
 107:src/MemoryAllocator.cpp ****         mergeAdjacent(freeListHead);
 108:src/MemoryAllocator.cpp ****         return 0;
 109:src/MemoryAllocator.cpp ****     }
 110:src/MemoryAllocator.cpp **** 
 111:src/MemoryAllocator.cpp ****     //Insert into list in correct order
 112:src/MemoryAllocator.cpp ****     while (curr != nullptr && free_blk > curr) {
 113:src/MemoryAllocator.cpp ****         prev = curr;
