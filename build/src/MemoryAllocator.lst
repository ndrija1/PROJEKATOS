  81:src/MemoryAllocator.cpp **** int MemoryAllocator::mem_free(void *ptr) {
  82:src/MemoryAllocator.cpp ****     if (!ptr) return -1;
  83:src/MemoryAllocator.cpp ****     if (ptr < HEAP_START_ADDR || ptr >= HEAP_END_ADDR) return -1;
  84:src/MemoryAllocator.cpp **** 
  85:src/MemoryAllocator.cpp **** 
  86:src/MemoryAllocator.cpp ****     FreeBlock* curr = freeListHead;
  87:src/MemoryAllocator.cpp ****     FreeBlock* prev = nullptr;
  88:src/MemoryAllocator.cpp ****     FreeBlock* free_blk = reinterpret_cast<FreeBlock*>(ptr) - 1;
  89:src/MemoryAllocator.cpp **** 
  90:src/MemoryAllocator.cpp **** 
  91:src/MemoryAllocator.cpp ****     //The whole address space was allocated
  92:src/MemoryAllocator.cpp ****     if (!curr) {
  93:src/MemoryAllocator.cpp ****         freeListHead = free_blk;
  94:src/MemoryAllocator.cpp ****         free_blk->next = nullptr;
  95:src/MemoryAllocator.cpp ****         return 0;
  96:src/MemoryAllocator.cpp ****     }
  97:src/MemoryAllocator.cpp ****     if (free_blk < curr) {
  98:src/MemoryAllocator.cpp ****         free_blk->next = freeListHead;
  99:src/MemoryAllocator.cpp ****         freeListHead = free_blk;
 100:src/MemoryAllocator.cpp ****         mergeAdjacent(freeListHead);
 101:src/MemoryAllocator.cpp ****         return 0;
 102:src/MemoryAllocator.cpp ****     }
 103:src/MemoryAllocator.cpp **** 
 104:src/MemoryAllocator.cpp ****     //Insert into list in correct order
 105:src/MemoryAllocator.cpp ****     while (curr != nullptr && free_blk > curr) {
 106:src/MemoryAllocator.cpp ****         prev = curr;
 107:src/MemoryAllocator.cpp ****         curr = curr->next;
 108:src/MemoryAllocator.cpp ****     }
 109:src/MemoryAllocator.cpp ****     if (curr == nullptr) {
 110:src/MemoryAllocator.cpp ****         prev->next = free_blk;
 111:src/MemoryAllocator.cpp ****         free_blk->next = nullptr;
 112:src/MemoryAllocator.cpp ****         mergeAdjacent(prev);
 113:src/MemoryAllocator.cpp ****         return 0;
